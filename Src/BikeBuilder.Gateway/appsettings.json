{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The same route contract as the APIM APIs (infra/modules/apim.bicep): /orders and /ratings
  // are prefix-stripped, everything else falls through to the catalog api so gRPC-Web method
  // paths need no prefix. The AppHost overrides only the destination addresses per mode.
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "ratings": {
        "ClusterId": "ratings",
        "Match": { "Path": "/ratings/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/ratings" } ]
      },
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "api": { "Destinations": { "default": { "Address": "http://localhost:7101" } } },
      "orders": { "Destinations": { "default": { "Address": "http://localhost:7401" } } },
      "ratings": { "Destinations": { "default": { "Address": "http://localhost:7071" } } }
    }
  }
}
