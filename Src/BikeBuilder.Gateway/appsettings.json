{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // The same route contract as the APIM APIs (infra/modules/apim.bicep): /orders, /ratings and
  // /chat are prefix-stripped, everything else falls through to the catalog api so gRPC-Web
  // method paths need no prefix. The AppHost overrides only the destination addresses per mode.
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "ratings": {
        "ClusterId": "ratings",
        "Match": { "Path": "/ratings/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/ratings" } ]
      },
      "chat": {
        "ClusterId": "chat",
        "Match": { "Path": "/chat/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/chat" } ]
      },
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/{**rest}" }
      }
    },
    "Clusters": {
      "api": { "Destinations": { "default": { "Address": "http://localhost:7101" } } },
      "orders": { "Destinations": { "default": { "Address": "http://localhost:7401" } } },
      "ratings": { "Destinations": { "default": { "Address": "http://localhost:7071" } } },
      "chat": {
        // An assistant answer can take minutes on a cold local model (load, then several tool
        // round trips). YARP's default 100s activity timeout would answer 504 on its own - and
        // a gateway-generated error carries no CORS headers, which the browser reports as a
        // bare "Failed to fetch". Matches the admin app's five-minute client timeout.
        "HttpRequest": { "ActivityTimeout": "00:05:00" },
        "Destinations": { "default": { "Address": "http://localhost:7701" } }
      }
    }
  }
}
