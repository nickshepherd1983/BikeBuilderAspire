@page "/orders"
@attribute [Authorize(Policy = Policies.ViewOrders)]

<PageTitle>Orders</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Orders</MudText>
<MudText Typo="Typo.body1" Class="mb-4">Everything customers have bought in the public store. Carts still being filled in are on the <MudLink Href="orders/in-process">In Process</MudLink> page.</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-8" />
}
else if (_orders.Count == 0)
{
    <MudText>No orders yet — send someone to the public store!</MudText>
}
else
{
    <MudTable Items="_orders" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Order</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Placed</MudTh>
            <MudTh>Ship to</MudTh>
            <MudTh>Items</MudTh>
            <MudTh Style="text-align: right;">Total</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Order">#@context.Id</MudTd>
            <MudTd DataLabel="Customer">
                <MudText Typo="Typo.body2">@context.CustomerName</MudText>
                @if (context.CustomerEmail is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CustomerEmail</MudText>
                }
                @if (context.CustomerPhone is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.CustomerPhone</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Status == "PLACED" ? Color.Success : Color.Default)">
                    @FormatStatus(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Placed">@(context.PlacedAt?.LocalDateTime.ToString("g") ?? "—")</MudTd>
            <MudTd DataLabel="Ship to">
                <MudText Typo="Typo.body2">@context.ShippingAddress.FullName</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.ShippingAddress.Line1</MudText>
                @if (context.ShippingAddress.Line2 is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.ShippingAddress.Line2</MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.ShippingAddress.City, @context.ShippingAddress.State @context.ShippingAddress.PostalCode</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.ShippingAddress.Country</MudText>
            </MudTd>
            <MudTd DataLabel="Items">
                @foreach (var item in context.Items)
                {
                    <MudText Typo="Typo.body2">@item.ProductName × @item.Quantity — @item.LineTotal.ToString("C2")</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Total" Style="text-align: right;">
                <MudText Typo="Typo.body2">@context.Total.ToString("C2")</MudText>
                @* Shipping is folded into the total; the caption says how much of it and how it ships. *@
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@FormatStatus(context.ShippingMethod) shipping @context.ShippingCost.ToString("C2")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Payment.Summary</MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
