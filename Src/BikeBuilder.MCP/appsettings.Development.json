{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mcp": {
    // Lets local MCP clients (Claude Code, VS Code, the MCP Inspector) connect to /mcp without
    // an Auth0 token. The orders tools still need one and say so when it is missing.
    "AllowAnonymous": true
  }
}
