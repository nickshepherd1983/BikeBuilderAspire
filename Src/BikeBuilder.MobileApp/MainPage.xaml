<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:BikeBuilder.Web.Public.Components;assembly=BikeBuilder.Web.Public.Shared"
             x:Class="BikeBuilder.MobileApp.MainPage">

    <!-- Rooting the shared Routes component gives the exact same Router/MainLayout/MudBlazor
         tree the web storefront renders. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
