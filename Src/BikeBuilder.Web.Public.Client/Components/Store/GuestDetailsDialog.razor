<MudDialog>
    <TitleContent>Checkout details</TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Your name" Required="true" RequiredError="Name is required" />
            <MudTextField @bind-Value="_email" Label="Email (optional)" InputType="InputType.Email" Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Start order</MudButton>
    </DialogActions>
</MudDialog>
