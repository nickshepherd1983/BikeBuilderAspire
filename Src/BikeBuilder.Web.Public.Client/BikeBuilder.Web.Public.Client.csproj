<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The composition root keeps the storefront's namespace so it lines up with the
         components in BikeBuilder.Web.Public.Shared (which sets the same root namespace). -->
    <RootNamespace>BikeBuilder.Web.Public</RootNamespace>
    <!-- Same reason as BikeBuilder.Web.Admin: the WASM HTTP client's streaming response mode
         breaks gRPC-Web calls with "Failed to fetch". -->
    <WasmEnableStreamingResponse>false</WasmEnableStreamingResponse>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- All storefront components, catalog/orders clients, and protos live in the shared RCL
         so the MAUI app (BikeBuilder.MobileApp) can render the identical storefront. -->
    <ProjectReference Include="..\BikeBuilder.Web.Public.Shared\BikeBuilder.Web.Public.Shared.csproj" />
  </ItemGroup>

</Project>
