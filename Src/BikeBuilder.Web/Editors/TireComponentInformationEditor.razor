@inherits ComponentInformationEditor<TireComponentInformation>

<MudSelect T="WheelSize?" @bind-Value="Value.Size" Label="Size" Required="true" RequiredError="Size is required" Class="mt-3">
    @foreach (var size in WheelSize.All)
    {
        <MudSelectItem T="WheelSize?" Value="size">@size</MudSelectItem>
    }
</MudSelect>
<MudSelect T="TireWidthInches?" @bind-Value="Value.WidthInches" Label="Width (inches)" Required="true" RequiredError="Width is required" Class="mt-3">
    @foreach (var width in TireWidthInches.Common)
    {
        <MudSelectItem T="TireWidthInches?" Value="width">@width</MudSelectItem>
    }
</MudSelect>
