@inherits ComponentInformationEditor<RimComponentInformation>

<MudSelect T="WheelSize?" @bind-Value="Value.Size" Label="Size" Required="true" RequiredError="Size is required" Class="mt-3">
    @foreach (var size in WheelSize.All)
    {
        <MudSelectItem T="WheelSize?" Value="size">@size</MudSelectItem>
    }
</MudSelect>
