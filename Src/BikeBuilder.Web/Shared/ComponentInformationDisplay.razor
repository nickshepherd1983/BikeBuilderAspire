@if (_information is not null)
{
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@_information.DisplayName</MudChip>
        @foreach (var (label, value) in _information.GetDisplayValues())
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@label: @value</MudChip>
        }
    </MudStack>
}
