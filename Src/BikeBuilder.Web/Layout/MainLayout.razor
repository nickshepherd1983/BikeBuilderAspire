@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">The Worlds BEST Bike Builder</MudText>
        <MudSpacer />
        <LoginDisplay />
        <MudIconButton Icon="@Icons.Material.Filled.PedalBike" Color="Color.Inherit" Href="https://learn.microsoft.com/aspnet/core/" Target="_blank" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @* Full-width content; pb-16 keeps it clear of the fixed footer bar *@
        <MudContainer MaxWidth="MaxWidth.False" Class="my-6 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>
    <MudAppBar Bottom="true" Fixed="true" Dense="true" Elevation="1" Class="app-footer">
        <MudLink Href="/" Class="mr-6" Style="color: white;">Home</MudLink>
        <MudLink Href="/about" Class="mr-6" Style="color: white;">About Us</MudLink>
        <MudLink Href="https://github.com/nickshepherd1983/BikeBuilder" Target="_blank" Style="color: white;">GitHub</MudLink>
    </MudAppBar>
</MudLayout>
